<UserControl x:Class="ViscaCamLink.Simulator.PositionCompassControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Viewbox Stretch="Uniform">
        <Canvas Width="200" Height="200" Background="Transparent">
            <!-- Outer circle (pan range) -->
            <Ellipse Width="190" Height="190" Canvas.Left="5" Canvas.Top="5"
                     Stroke="#555" StrokeThickness="1" Fill="#1A1A2E"/>
            
            <!-- Grid lines (crosshair) -->
            <Line X1="100" Y1="10" X2="100" Y2="190" Stroke="#333" StrokeThickness="0.5"/>
            <Line X1="10" Y1="100" X2="190" Y2="100" Stroke="#333" StrokeThickness="0.5"/>
            
            <!-- 45-degree lines -->
            <Line X1="33" Y1="33" X2="167" Y2="167" Stroke="#222" StrokeThickness="0.5"/>
            <Line X1="167" Y1="33" X2="33" Y2="167" Stroke="#222" StrokeThickness="0.5"/>
            
            <!-- Inner circles (tilt range markers) -->
            <Ellipse Width="126" Height="126" Canvas.Left="37" Canvas.Top="37"
                     Stroke="#333" StrokeThickness="0.5" Fill="Transparent"/>
            <Ellipse Width="63" Height="63" Canvas.Left="68.5" Canvas.Top="68.5"
                     Stroke="#333" StrokeThickness="0.5" Fill="Transparent"/>

            <!-- Cardinal labels -->
            <TextBlock Text="L" Canvas.Left="12" Canvas.Top="92" Foreground="#888" FontSize="10"/>
            <TextBlock Text="R" Canvas.Left="182" Canvas.Top="92" Foreground="#888" FontSize="10"/>
            <TextBlock Text="U" Canvas.Left="95" Canvas.Top="8" Foreground="#888" FontSize="10"/>
            <TextBlock Text="D" Canvas.Left="95" Canvas.Top="178" Foreground="#888" FontSize="10"/>

            <!-- Position indicator (shows where camera is pointing) -->
            <Ellipse x:Name="PositionDot" Width="10" Height="10"
                     Fill="#00E676" Opacity="0.9">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="PositionTransform" X="95" Y="95"/>
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Velocity vector arrow (shows movement direction) -->
            <Line x:Name="VelocityLine" X1="100" Y1="100" X2="100" Y2="100"
                  Stroke="#FF5252" StrokeThickness="2" StrokeEndLineCap="Triangle"
                  Visibility="Collapsed"/>

            <!-- Zoom ring indicator -->
            <Ellipse x:Name="ZoomRing" Width="190" Height="190" Canvas.Left="5" Canvas.Top="5"
                     Stroke="#448AFF" StrokeThickness="3" Fill="Transparent" Opacity="0"
                     StrokeDashArray="2 1"/>
        </Canvas>
    </Viewbox>
</UserControl>
