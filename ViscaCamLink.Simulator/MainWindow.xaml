<Window x:Class="ViscaCamLink.Simulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ViscaCamLink.Simulator"
        Title="ViscaCamLink Simulator" Height="700" Width="900"
        Background="#1A1A2E" Foreground="White"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <local:SimulatorViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Value">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <local:BoolToColorConverter x:Key="BoolToGreen" TrueColor="#00E676" FalseColor="#FF5252"/>
        <local:BoolToStringConverter x:Key="BoolToOnOff" TrueString="ON" FalseString="OFF"/>
        <local:BoolToStringConverter x:Key="BoolToConnected" TrueString="Connected" FalseString="No client"/>
        <local:InvertBoolConverter x:Key="InvertBool"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Server Controls -->
        <Border Grid.Row="0" Background="#16213E" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Port:" Style="{StaticResource Label}" Margin="0,0,6,0"/>
                <TextBox Grid.Column="1" Width="60" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         Background="#0F3460" Foreground="White" BorderBrush="#333" Padding="4,2"
                         IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBool}}"/>

                <Button Grid.Column="2" Content="▶ Start" Margin="12,0,4,0" Padding="12,4"
                        Command="{Binding StartServerCommand}"
                        Background="#00E676" Foreground="#1A1A2E" FontWeight="Bold" BorderBrush="Transparent"/>
                <Button Grid.Column="3" Content="■ Stop" Margin="4,0,0,0" Padding="12,4"
                        Command="{Binding StopServerCommand}"
                        Background="#FF5252" Foreground="White" FontWeight="Bold" BorderBrush="Transparent"/>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding IsClientConnected, Converter={StaticResource BoolToGreen}}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding IsClientConnected, Converter={StaticResource BoolToConnected}}"
                               Style="{StaticResource Label}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Compass + Status -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Compass Control -->
                <Border Background="#16213E" CornerRadius="6" Padding="12" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Camera Position &amp; Movement" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#AAA" Margin="0,0,0,8"/>
                        <local:PositionCompassControl Grid.Row="1"
                            PanNormalized="{Binding PanNormalized}"
                            TiltNormalized="{Binding TiltNormalized}"
                            ZoomNormalized="{Binding ZoomNormalized}"
                            PanVelocity="{Binding PanVelocity}"
                            TiltVelocity="{Binding TiltVelocity}"/>
                    </Grid>
                </Border>

                <!-- Status Panel below compass -->
                <Border Grid.Row="1" Background="#16213E" CornerRadius="6" Padding="12" Margin="0,12,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Power -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Power" Style="{StaticResource Label}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Value}"
                                   Text="{Binding IsPoweredOn, Converter={StaticResource BoolToOnOff}}">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="{Binding IsPoweredOn, Converter={StaticResource BoolToGreen}}"/>
                            </TextBlock.Foreground>
                        </TextBlock>

                        <!-- Preset -->
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Last Preset" Style="{StaticResource Label}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}"
                                   Text="{Binding LastPreset}"/>

                        <!-- Last Command -->
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Last Command" Style="{StaticResource Label}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Value}"
                                   Text="{Binding LastCommand}" TextTrimming="CharacterEllipsis"/>

                        <!-- Position Values -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Pan" Style="{StaticResource Label}" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Value}">
                            <Run Text="{Binding Pan, Mode=OneWay}"/>
                            <Run Text=" " Foreground="#666"/>
                            <Run Text="{Binding PanVelocity, Mode=OneWay, StringFormat='v:{0}'}" Foreground="#448AFF"/>
                        </TextBlock>

                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Tilt" Style="{StaticResource Label}" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}">
                            <Run Text="{Binding Tilt, Mode=OneWay}"/>
                            <Run Text=" " Foreground="#666"/>
                            <Run Text="{Binding TiltVelocity, Mode=OneWay, StringFormat='v:{0}'}" Foreground="#448AFF"/>
                        </TextBlock>

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Zoom" Style="{StaticResource Label}" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Value}">
                            <Run Text="{Binding Zoom, Mode=OneWay}"/>
                            <Run Text=" " Foreground="#666"/>
                            <Run Text="{Binding ZoomVelocity, Mode=OneWay, StringFormat='v:{0}'}" Foreground="#448AFF"/>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right: Command Log -->
            <Border Grid.Column="1" Background="#16213E" CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Command Log" FontSize="13" FontWeight="SemiBold"
                               Foreground="#AAA" Margin="0,0,0,8"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}"
                             Background="Transparent" BorderBrush="#333" Foreground="#CCC"
                             FontFamily="Consolas" FontSize="11"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2,1"/>
                                <Setter Property="Foreground" Value="#CCC"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <Button Grid.Row="2" Content="Clear" Margin="0,8,0,0" Padding="8,4"
                            Command="{Binding ClearLogCommand}"
                            Background="#333" Foreground="#AAA" BorderBrush="#555"
                            HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Reset Position" Padding="10,4" Margin="0,0,8,0"
                        Command="{Binding ResetPositionCommand}"
                        Background="#333" Foreground="#AAA" BorderBrush="#555"/>
                <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center">
                    <Run Text="Connect main app to: 127.0.0.1:"/>
                    <Run Text="{Binding Port, Mode=OneWay}" Foreground="#448AFF"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
