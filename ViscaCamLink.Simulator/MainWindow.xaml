<Window x:Class="ViscaCamLink.Simulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ViscaCamLink.Simulator"
        Title="ViscaCamLink Simulator" Height="700" Width="900"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <local:SimulatorViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <local:BoolToStringConverter x:Key="BoolToOnOff" TrueString="ON" FalseString="OFF"/>
        <local:BoolToStringConverter x:Key="BoolToConnected" TrueString="Connected" FalseString="No client"/>
        <local:InvertBoolConverter x:Key="InvertBool"/>

        <Style x:Key="PanelBorder" TargetType="Border" BasedOn="{StaticResource BaseBorder}">
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="StatusValueTextBlock" TargetType="TextBlock" BasedOn="{StaticResource ValueTextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPoweredOn}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource StatusOkBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConnectionEllipse" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Fill" Value="{DynamicResource StatusErrorBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsClientConnected}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource StatusOkBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Server Controls -->
        <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Port:" Style="{StaticResource LabelTextBlock}" Margin="0,0,6,0"/>
                <TextBox Grid.Column="1" Width="60" Style="{StaticResource BaseTextBox}"
                         Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBool}}"/>

                <Button Grid.Column="2" Content="▶ Start" Margin="12,0,4,0"
                        Style="{StaticResource AccentButton}"
                        Command="{Binding StartServerCommand}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBool}}"/>
                <Button Grid.Column="3" Content="■ Stop" Margin="4,0,0,0"
                        Style="{StaticResource BaseButton}"
                        Command="{Binding StopServerCommand}"
                        IsEnabled="{Binding IsRunning}"/>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource ConnectionEllipse}"/>
                    <TextBlock Text="{Binding IsClientConnected, Converter={StaticResource BoolToConnected}}"
                               Style="{StaticResource LabelTextBlock}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Compass + Status -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Compass Control -->
                <Border Style="{StaticResource PanelBorder}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Camera Position" Style="{StaticResource HeaderTextBlock}"
                                   Margin="0,0,0,8"/>
                        <local:PositionCompassControl Grid.Row="1"
                            PanNormalized="{Binding PanNormalized}"
                            TiltNormalized="{Binding TiltNormalized}"
                            ZoomNormalized="{Binding ZoomNormalized}"
                            PanVelocity="{Binding PanVelocity}"
                            TiltVelocity="{Binding TiltVelocity}"/>
                    </Grid>
                </Border>

                <!-- Status Panel below compass -->
                <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Margin="0,12,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Power -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Power" Style="{StaticResource LabelTextBlock}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource StatusValueTextBlock}"
                                   Text="{Binding IsPoweredOn, Converter={StaticResource BoolToOnOff}}"/>

                        <!-- Preset -->
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Last Preset" Style="{StaticResource LabelTextBlock}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextBlock}"
                                   Text="{Binding LastPreset}"/>

                        <!-- Last Command -->
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Last Command" Style="{StaticResource LabelTextBlock}"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueTextBlock}"
                                   Text="{Binding LastCommand}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding LastCommand}"
                                   ToolTipOpening="OnTrimmedTextToolTipOpening"/>

                        <!-- Position Values -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Pan" Style="{StaticResource LabelTextBlock}" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource ValueTextBlock}">
                            <Run Text="{Binding Pan, Mode=OneWay}"/>
                            <Run Text=" " Foreground="{DynamicResource TextMutedBrush}"/>
                            <Run Text="{Binding PanVelocity, Mode=OneWay, StringFormat='v:{0}'}" Foreground="{DynamicResource AccentBrush}"/>
                        </TextBlock>

                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Tilt" Style="{StaticResource LabelTextBlock}" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueTextBlock}">
                            <Run Text="{Binding Tilt, Mode=OneWay}"/>
                            <Run Text=" " Foreground="{DynamicResource TextMutedBrush}"/>
                            <Run Text="{Binding TiltVelocity, Mode=OneWay, StringFormat='v:{0}'}" Foreground="{DynamicResource AccentBrush}"/>
                        </TextBlock>

                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Zoom" Style="{StaticResource LabelTextBlock}" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource ValueTextBlock}">
                            <Run Text="{Binding Zoom, Mode=OneWay}"/>
                            <Run Text=" " Foreground="{DynamicResource TextMutedBrush}"/>
                            <Run Text="{Binding ZoomVelocity, Mode=OneWay, StringFormat='v:{0}'}" Foreground="{DynamicResource AccentBrush}"/>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right: Command Log -->
            <Border Grid.Column="1" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Command Log" Style="{StaticResource HeaderTextBlock}" Margin="0,0,0,8"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}"
                             Style="{StaticResource BaseListBox}"
                             ItemContainerStyle="{StaticResource BaseListBoxItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" Content="Clear" Margin="0,8,0,0"
                            Style="{StaticResource BaseButton}"
                            Command="{Binding ClearLogCommand}"
                            HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Reset Position" Margin="0,0,8,0"
                    Style="{StaticResource BaseButton}"
                    Command="{Binding ResetPositionCommand}"/>
            <TextBlock Style="{StaticResource LabelTextBlock}">
                <Run Text="Connect main app to: 127.0.0.1:"/>
                <Run Text="{Binding Port, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
