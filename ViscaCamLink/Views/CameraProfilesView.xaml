<Window x:Class="ViscaCamLink.Views.CameraProfilesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:localization="clr-namespace:ViscaCamLink.Infrastructure.Localization"
        xmlns:viewmodels="clr-namespace:ViscaCamLink.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:CameraProfilesViewModel}"
        Title="{Binding [Common_AppTitle], Source={x:Static localization:TranslationSource.Instance}}"
        Width="480"
        Height="Auto"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ViscaCamLink;component/Resources/CommonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="InputBorder"
                   TargetType="{x:Type Border}">
                <Setter Property="Background"
                        Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource BorderBrush}" />
                <Setter Property="BorderThickness"
                        Value="{StaticResource DefaultBorderThickness}" />
                <Setter Property="CornerRadius"
                        Value="{StaticResource DefaultCornerRadius}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver"
                             Value="True">
                        <Setter Property="BorderBrush"
                                Value="{DynamicResource HoverBorderBrush}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin"
                             Value="True">
                        <Setter Property="BorderBrush"
                                Value="{DynamicResource FocusBorderBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel>
        <Border Margin="{StaticResource DefaultMargin}"
                Style="{StaticResource BaseBorder}">
            <StackPanel Margin="{StaticResource DefaultMargin}">
                <DockPanel Height="24"
                           LastChildFill="False">
                    <TextBlock VerticalAlignment="Stretch"
                               Text="{Binding [CameraProfile_Title], Source={x:Static localization:TranslationSource.Instance}}"
                               Style="{StaticResource HeaderTextBlock}" />

                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                IsEnabled="{Binding IsEditing, Converter={StaticResource InverseBooleanConverter}}">
                        <Button Width="24"
                                VerticalAlignment="Stretch"
                                Command="{Binding AddCommand}"
                                ToolTip="{Binding [Common_Add], Source={x:Static localization:TranslationSource.Instance}}"
                                Style="{StaticResource BorderlessButton}">
                            <Path Data="{StaticResource Plus}"
                                  Style="{StaticResource Icon16Path}" />
                        </Button>

                        <Button Width="24"
                                Margin="4,0,0,0"
                                VerticalAlignment="Stretch"
                                Command="{Binding EditCommand}"
                                ToolTip="{Binding [Common_Edit], Source={x:Static localization:TranslationSource.Instance}}"
                                Style="{StaticResource BorderlessButton}">
                            <Path Data="{StaticResource Pencil}"
                                  Style="{StaticResource Icon16Path}" />
                        </Button>

                        <Button Width="24"
                                Margin="4,0,0,0"
                                VerticalAlignment="Stretch"
                                Command="{Binding DeleteCommand}"
                                ToolTip="{Binding [Common_Delete], Source={x:Static localization:TranslationSource.Instance}}"
                                Style="{StaticResource BorderlessButton}">
                            <Path Data="{StaticResource Trash}"
                                  Style="{StaticResource Icon16Path}" />
                        </Button>
                    </StackPanel>
                </DockPanel>

                <Border Height="160"
                        Margin="0,4,0,0"
                        Padding="4"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource DefaultCornerRadius}">
                    <ListBox Style="{StaticResource BaseListBox}"
                             ItemContainerStyle="{StaticResource BaseListBoxItem}"
                             ItemsSource="{Binding Cameras}"
                             SelectedItem="{Binding SelectedCamera}"
                             IsEnabled="{Binding IsEditing, Converter={StaticResource InverseBooleanConverter}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewmodels:CameraProfileItemViewModel}">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal">
                                        <TextBlock x:Name="NameText"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Name}"
                                                   Style="{StaticResource BaseTextBlock}" />

                                        <Border Margin="8,0,0,0"
                                                Padding="6,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource AccentBrush}"
                                                CornerRadius="{StaticResource DefaultCornerRadius}"
                                                Visibility="{Binding IsActive, Converter={StaticResource FalseToCollapsedConverter}}">
                                            <TextBlock Foreground="{DynamicResource AccentContentBrush}"
                                                       Text="{Binding [CameraProfile_Active], Source={x:Static localization:TranslationSource.Instance}}"
                                                       Style="{StaticResource BaseTextBlock}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Style="{StaticResource BaseTextBlock}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}:{1}">
                                                <Binding Path="Ip" />
                                                <Binding Path="Port" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Border Margin="0,4,0,0"
                        Padding="4"
                        Style="{StaticResource BaseBorder}"
                        Visibility="{Binding IsEditing, Converter={StaticResource FalseToCollapsedConverter}}">
                    <Border.InputBindings>
                        <KeyBinding Key="Enter"
                                    Command="{Binding SaveEditCommand}" />
                        <KeyBinding Key="Escape"
                                    Command="{Binding CancelEditCommand}" />
                    </Border.InputBindings>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{Binding [CameraProfile_Name], Source={x:Static localization:TranslationSource.Instance}}"
                                   Style="{StaticResource BaseTextBlock}" />

                        <Border Grid.Row="0"
                                Grid.Column="1"
                                Height="28"
                                Margin="0,0,0,6"
                                Style="{StaticResource InputBorder}">
                            <TextBox Margin="4,0"
                                     VerticalContentAlignment="Center"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextBrush}"
                                     Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{Binding [CameraProfile_Ip], Source={x:Static localization:TranslationSource.Instance}}"
                                   Style="{StaticResource BaseTextBlock}" />

                        <Border Grid.Row="1"
                                Grid.Column="1"
                                Height="28"
                                Margin="0,0,0,6"
                                Style="{StaticResource InputBorder}">
                            <TextBox Margin="4,0"
                                     VerticalContentAlignment="Center"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextBrush}"
                                     Text="{Binding EditIp, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{Binding [CameraProfile_Port], Source={x:Static localization:TranslationSource.Instance}}"
                                   Style="{StaticResource BaseTextBlock}" />

                        <Border Grid.Row="2"
                                Grid.Column="1"
                                Height="28"
                                Style="{StaticResource InputBorder}">
                            <TextBox Margin="4,0"
                                     VerticalContentAlignment="Center"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextBrush}"
                                     Text="{Binding EditPort, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>

                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource StatusErrorBrush}"
                                   Text="{Binding ValidationMessage}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ValidationMessage, Converter={StaticResource StringEmptyToCollapsedConverter}}"
                                   Style="{StaticResource BaseTextBlock}" />

                        <StackPanel Grid.Row="4"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,10,0,0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button MinWidth="100"
                                    Height="28"
                                    Margin="0,0,8,0"
                                    Content="{Binding [Common_Save], Source={x:Static localization:TranslationSource.Instance}}"
                                    Command="{Binding SaveEditCommand}"
                                    Style="{StaticResource AccentButton}" />

                            <Button MinWidth="100"
                                    Height="28"
                                    Content="{Binding [Common_Cancel], Source={x:Static localization:TranslationSource.Instance}}"
                                    Command="{Binding CancelEditCommand}"
                                    Style="{StaticResource DialogButton}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <StackPanel Margin="{StaticResource DefaultMarginTopless}"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Height="32"
                    Width="120"
                    Content="{Binding [Common_OK], Source={x:Static localization:TranslationSource.Instance}}"
                    Command="{Binding CloseCommand}"
                    IsCancel="True"
                    Style="{StaticResource AccentButton}" />
        </StackPanel>
    </StackPanel>
</Window>
