<Window x:Class="ViscaCamLink.Views.MessageView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:ViscaCamLink.Services"
        xmlns:viewmodels="clr-namespace:ViscaCamLink.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:MessageViewModel}"
        Title="{Binding Title}"
        Width="480"
        Height="Auto"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ViscaCamLink;component/Resources/CommonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="MessageIconDisc"
                   TargetType="{x:Type Ellipse}">
                <Setter Property="Width"
                        Value="40" />
                <Setter Property="Height"
                        Value="40" />
                <Setter Property="VerticalAlignment"
                        Value="Top" />
                <Setter Property="Fill"
                        Value="{DynamicResource AccentBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}"
                                 Value="{x:Static services:MessageKind.Warning}">
                        <Setter Property="Fill"
                                Value="{DynamicResource StatusWarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}"
                                 Value="{x:Static services:MessageKind.Error}">
                        <Setter Property="Fill"
                                Value="{DynamicResource StatusErrorBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MessageIconGlyph"
                   TargetType="{x:Type Path}"
                   BasedOn="{StaticResource BaseIconPath}">
                <Setter Property="Width"
                        Value="20" />
                <Setter Property="Height"
                        Value="20" />
                <Setter Property="Margin"
                        Value="0,10,0,0" />
                <Setter Property="VerticalAlignment"
                        Value="Top" />
                <Setter Property="Fill"
                        Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="Data"
                        Value="{StaticResource MessageInformation}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}"
                                 Value="{x:Static services:MessageKind.Question}">
                        <Setter Property="Data"
                                Value="{StaticResource MessageQuestion}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}"
                                 Value="{x:Static services:MessageKind.Warning}">
                        <Setter Property="Data"
                                Value="{StaticResource MessageWarning}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}"
                                 Value="{x:Static services:MessageKind.Error}">
                        <Setter Property="Data"
                                Value="{StaticResource MessageError}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="24,24,24,20">

        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Left">
                <Ellipse Style="{StaticResource MessageIconDisc}" />
                <Path Style="{StaticResource MessageIconGlyph}"
                      HorizontalAlignment="Center" />
            </Grid>

            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource HeaderTextBlock}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <TextBlock Text="{Binding Text}"
                           Style="{StaticResource BaseTextBlock}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="{Binding SecondaryButtonText}"
                    Command="{Binding SecondaryCommand}"
                    Visibility="{Binding HasSecondaryButton, Converter={StaticResource FalseToCollapsedConverter}}"
                    IsDefault="{Binding IsSecondaryDefault, Mode=OneTime}"
                    IsCancel="True"
                    Style="{StaticResource DialogButton}"
                    Width="120"
                    Height="30"
                    Margin="0,0,8,0" />

            <Button Content="{Binding PrimaryButtonText}"
                    Command="{Binding PrimaryCommand}"
                    IsDefault="{Binding IsPrimaryDefault, Mode=OneTime}"
                    Style="{StaticResource AccentButton}"
                    Width="120"
                    Height="30" />

        </StackPanel>

    </StackPanel>

</Window>
