<Window x:Class="ViscaCamLink.Views.UpdateDownloadView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:resources="clr-namespace:ViscaCamLink.Resources"
        xmlns:util="clr-namespace:ViscaCamLink.Util"
        xmlns:viewmodels="clr-namespace:ViscaCamLink.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:UpdateDownloadViewModel}"
        Title="{Binding [Common_AppTitle], Source={x:Static util:TranslationSource.Instance}}"
        Width="400"
        Height="160"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ContentRendered="Window_ContentRendered">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ViscaCamLink;component/Util/CommonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{StaticResource DefaultMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource BaseBorder}">
            <Grid Margin="{StaticResource ExtendedMargin}">

                <!-- Downloading panel -->
                <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource FalseToCollapsedConverter}}">
                    <TextBlock Text="{Binding [Updater_Downloading], Source={x:Static util:TranslationSource.Instance}}"
                               Style="{StaticResource HeaderTextBlock}" />
                    <TextBlock Text="{Binding AssetName}"
                               Margin="0,4,0,0"
                               Style="{StaticResource BaseTextBlock}" />
                    <ProgressBar Height="8"
                                 Margin="0,12,0,0"
                                 Value="{Binding Progress}"
                                 Maximum="100"
                                 IsIndeterminate="{Binding IsIndeterminate}" />
                </StackPanel>

                <!-- Error panel -->
                <StackPanel Visibility="{Binding HasError, Converter={StaticResource FalseToCollapsedConverter}}">
                    <TextBlock Text="{Binding [Updater_DownloadError], Source={x:Static util:TranslationSource.Instance}}"
                               Style="{StaticResource HeaderTextBlock}" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource BaseTextBlock}" />
                </StackPanel>

            </Grid>
        </Border>

        <StackPanel Grid.Row="1"
                    Margin="0,4,4,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="80"
                    Content="{Binding [Updater_Retry], Source={x:Static util:TranslationSource.Instance}}"
                    Visibility="{Binding HasError, Converter={StaticResource FalseToCollapsedConverter}}"
                    Command="{Binding RetryCommand}"
                    Style="{StaticResource DialogButton}" />
            <Button Width="80"
                    Margin="4,0,0,0"
                    Content="{Binding [Common_Cancel], Source={x:Static util:TranslationSource.Instance}}"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource DialogButton}" />
        </StackPanel>
    </Grid>
</Window>
