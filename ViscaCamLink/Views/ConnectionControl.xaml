<UserControl x:Class="ViscaCamLink.Views.ConnectionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:s="clr-namespace:System;assembly=mscorlib"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:util="clr-namespace:ViscaCamLink.Util"
             xmlns:converters="clr-namespace:ViscaCamLink.Converters"
             xmlns:viewmodels="clr-namespace:ViscaCamLink.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:ConnectionViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ViscaCamLink;component/Util/CommonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:ConnectionStatusToBrushConverter x:Key="ConnectionStatusToBrushConverter" />
            <converters:ConnectionStatusOkToBoolConverter x:Key="ConnectionStatusOkToBoolConverter" />
            <converters:PowerStatusToBrushConverter x:Key="PowerStatusToBrushConverter" />
            <converters:BoolAndConverter x:Key="BoolAndConverter" />

            <s:Boolean x:Key="True">True</s:Boolean>

            <Storyboard x:Key="FadeAnimation" 
                        RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 From="1" To="0" Duration="0:0:0.5"/>
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.5"
                                 BeginTime="0:0:0.5"/>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Margin="{StaticResource DefaultMargin}"
            Style="{StaticResource BaseBorder}">
        <Grid Margin="{StaticResource DefaultMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0"
                       Height="24"
                       LastChildFill="False">
                <TextBox DockPanel.Dock="Left"
                         BorderBrush="{StaticResource DefaultBorderBrush}"
                         Text="{Binding Ip}"
                         IsReadOnly="{Binding IsEditingConnection, 
                                              Converter={StaticResource InverseBooleanConverter}}"
                         PreviewTextInput="TextBox_PreviewTextInput_Ip"
                         DataObject.Pasting="TextBox_PastingHandler_Ip"
                         Style="{StaticResource HeaderTextBox}" />

                <TextBlock DockPanel.Dock="Left"
                           HorizontalAlignment="Center"
                           Text=":"
                           Style="{StaticResource HeaderTextBlock}" />

                <TextBox DockPanel.Dock="Left"
                         BorderBrush="{StaticResource DefaultBorderBrush}"
                         Text="{Binding Port}"
                         IsReadOnly="{Binding IsEditingConnection,
                                              Converter={StaticResource InverseBooleanConverter}}"
                         PreviewTextInput="TextBox_PreviewTextInput_Port"
                         DataObject.Pasting="TextBox_PastingHandler_Port"
                         Style="{StaticResource HeaderTextBox}" />

                <Button DockPanel.Dock="Right"
                        Width="24"
                        VerticalAlignment="Stretch"
                        Command="{Binding ConnectionEditCommand}"
                        IsEnabled="{Binding DataContext.Presets.IsSettingMemory,
                                            RelativeSource={RelativeSource AncestorType=Window},
                                            Converter={StaticResource InverseBooleanConverter}}"
                        Visibility="{Binding IsEditingConnection,
                                             Converter={StaticResource TrueToCollapsedConverter}}"
                        ToolTip="{Binding [Connection_Edit], Source={x:Static util:TranslationSource.Instance}}"
                        Style="{StaticResource BorderlessButton}">
                    <Path Data="{StaticResource Pencil}"
                          Style="{StaticResource Icon16Path}" />
                </Button>

                <Button DockPanel.Dock="Right"
                        Width="24"
                        VerticalAlignment="Stretch"
                        Command="{Binding ConnectionEditCommand}"
                        CommandParameter="{StaticResource True}"
                        Visibility="{Binding IsEditingConnection,
                                             Converter={StaticResource FalseToCollapsedConverter}}"
                        ToolTip="{Binding [Common_Cancel], Source={x:Static util:TranslationSource.Instance}}"
                        Style="{StaticResource BorderlessButton}">
                    <Path Data="{StaticResource Cross}"
                          Style="{StaticResource Icon16Path}" />
                </Button>

                <Button DockPanel.Dock="Right"
                        Width="24"
                        VerticalAlignment="Stretch"
                        Command="{Binding ConnectionEditCommand}"
                        Visibility="{Binding IsEditingConnection,
                                             Converter={StaticResource FalseToCollapsedConverter}}"
                        ToolTip="{Binding [Common_Save], Source={x:Static util:TranslationSource.Instance}}"
                        Style="{StaticResource BorderlessButton}">
                    <Path Data="{StaticResource Disk}"
                          Style="{StaticResource Icon16Path}" />
                </Button>
            </DockPanel>

            <DockPanel Grid.Row="1"
                       Height="24"
                       Margin="0,4,0,0"
                       LastChildFill="False">
                <Ellipse Height="12" 
                         Width="12"
                         Fill="{Binding Path=ConnectionStatus,
                                        Converter={StaticResource ConnectionStatusToBrushConverter}, Mode=Default}">
                    <Ellipse.Style>
                        <Style TargetType="{x:Type Ellipse}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ConnectionStatus}"
                                             Value="{x:Static util:ConnectionStatus.Working}">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="FadeAnimationStoryboard" Storyboard="{StaticResource FadeAnimation}"/>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="FadeAnimationStoryboard" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <Label Margin="4,0,0,0"
                       Content="{Binding ConnectionInfo}"
                       Style="{StaticResource BaseLabel}"/>

                <Button DockPanel.Dock="Right"
                        Width="24"
                        VerticalAlignment="Stretch"
                        Command="{Binding ReconnectCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BorderlessButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditingConnection}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.Presets.IsSettingMemory,
                                                               RelativeSource={RelativeSource AncestorType=Window}}"
                                             Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Data="{StaticResource Refresh}"
                          Style="{StaticResource Icon16Path}" />
                </Button>
            </DockPanel>

            <DockPanel Grid.Row="2"
                       Height="24"
                       Margin="0,4,0,0"
                       LastChildFill="False">
                <Ellipse Height="12" 
                         Width="12"
                         Fill="{Binding Path=PowerStatus,
                                        Converter={StaticResource PowerStatusToBrushConverter}, Mode=Default}">
                    <Ellipse.Style>
                        <Style TargetType="{x:Type Ellipse}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ChangingPowerStatus}"
                                             Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="FadeAnimationStoryboard" Storyboard="{StaticResource FadeAnimation}"/>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="FadeAnimationStoryboard"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <Label Margin="4,0,0,0"
                       Content="{Binding PowerInfo}"
                       Style="{StaticResource BaseLabel}"/>

                <Button DockPanel.Dock="Right"
                        Width="24"
                        VerticalAlignment="Stretch"
                        Command="{Binding PowerSwitchCommand}"
                        Style="{StaticResource BorderlessButton}">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{StaticResource BoolAndConverter}">
                            <Binding Path="IsEditingConnection"
                                     Converter="{StaticResource InverseBooleanConverter}" />
                            <Binding Path="ConnectionStatus"
                                     Converter="{StaticResource ConnectionStatusOkToBoolConverter}" />
                            <Binding Path="DataContext.Presets.IsSettingMemory"
                                     RelativeSource="{RelativeSource AncestorType=Window}"
                                     Converter="{StaticResource InverseBooleanConverter}" />
                        </MultiBinding>
                    </Button.IsEnabled>
                    <Path Data="{StaticResource Power}"
                          Style="{StaticResource Icon16Path}" />
                </Button>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
