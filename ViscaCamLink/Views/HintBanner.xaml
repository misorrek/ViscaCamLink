<UserControl x:Class="ViscaCamLink.Views.HintBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:localization="clr-namespace:ViscaCamLink.Infrastructure.Localization"
             xmlns:viewmodels="clr-namespace:ViscaCamLink.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:HintViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ViscaCamLink;component/Resources/CommonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceRaisedBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="3,1,1,1"
            CornerRadius="4"
            Padding="8,6"
            Margin="8,8,8,0"
            RenderTransformOrigin="0.5,0"
            Visibility="{Binding IsVisible,
                                 Converter={StaticResource FalseToCollapsedConverter}}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.45" />
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform />
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.25" />
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y"
                                         From="-16" To="0" Duration="0:0:0.25">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
        <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Width="20" Height="20" Margin="4,0,0,0"
                    VerticalAlignment="Top"
                    Command="{Binding DismissCommand}"
                    Style="{StaticResource BorderlessButton}"
                    ToolTip="{Binding [Hint_Dismiss], Source={x:Static localization:TranslationSource.Instance}}"
                    AutomationProperties.Name="{Binding [Hint_Dismiss], Source={x:Static localization:TranslationSource.Instance}}">
                <Path Data="{StaticResource Cross}"
                      Style="{StaticResource Icon16Path}"
                      Width="8" Height="8" />
            </Button>
            <TextBlock Text="{Binding Message}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontFamily="{StaticResource DefaultFontFamily}"
                       FontSize="11" />
        </DockPanel>
    </Border>
</UserControl>
