<Window x:Class="ViscaCamLink.Views.ViscaCamLinkView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:interface="clr-namespace:ViscaCamLink.Infrastructure.Interface"
        xmlns:localization="clr-namespace:ViscaCamLink.Infrastructure.Localization"
        xmlns:views="clr-namespace:ViscaCamLink.Views"
        xmlns:viewmodels="clr-namespace:ViscaCamLink.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:ViscaCamLinkViewModel}"
        Title="{Binding [Common_AppTitle], Source={x:Static localization:TranslationSource.Instance}}"
        Width="350"
        MinWidth="250"
        MaxWidth="500"
        SizeToContent="Height"
        ResizeMode="CanResize"
        LayoutUpdated="Window_LayoutUpdated"
        Deactivated="Window_Deactivated"
        Activated="Window_Activated">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ViscaCamLink;component/Resources/CommonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SidebarButton"
                   TargetType="{x:Type interface:SidebarButton}">
                <Setter Property="Background"
                        Value="{DynamicResource SecondaryBackgroundBrush}"/>
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type interface:SidebarButton}">
                            <Border Background="{TemplateBinding Background}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Margin="2,4,5,4"
                                            Width="3"
                                            CornerRadius="1"
                                            BorderThickness="0"
                                            Background="{DynamicResource PrimaryHighlightBrush}"
                                            Visibility="{Binding IsActive,
                                                                 RelativeSource={RelativeSource TemplatedParent},
                                                                 Converter={StaticResource FalseToHiddenConverter}}"/>
                                    <Path Data="{Binding Icon,
                                                         RelativeSource={RelativeSource TemplatedParent}}"
                                          Style="{StaticResource IconSidebarPath}" />
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background"
                                Value="{DynamicResource PrimaryForegroundBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="41" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Side pane -->
        <Border Grid.Column="0"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource DefaultBorderBrush}">

            <DockPanel LastChildFill="False"
                       Background="{DynamicResource SecondaryBackgroundBrush}">

                <interface:SidebarButton DockPanel.Dock="Top"
                                         Command="{Binding SidebarCommand}"
                                         CommandParameter="Connection"
                                         Icon="{StaticResource Connection}"
                                         IsActive="{Binding ConnectionContainerVisible}"
                                         Style="{StaticResource SidebarButton}" />

                <interface:SidebarButton DockPanel.Dock="Top"
                                         Command="{Binding SidebarCommand}"
                                         CommandParameter="Memory"
                                         Icon="{StaticResource Numpad}"
                                         IsActive="{Binding MemoryContainerVisible}"
                                         Style="{StaticResource SidebarButton}" />

                <interface:SidebarButton DockPanel.Dock="Top"
                                         Command="{Binding SidebarCommand}"
                                         CommandParameter="Move"
                                         Icon="{StaticResource MoveArrows}"
                                         IsActive="{Binding MoveContainerVisible}"
                                         Style="{StaticResource SidebarButton}" />

                <interface:SidebarButton DockPanel.Dock="Top"
                                         Command="{Binding SidebarCommand}"
                                         CommandParameter="Zoom"
                                         Icon="{StaticResource Zoom}"
                                         IsActive="{Binding ZoomContainerVisible}"
                                         Style="{StaticResource SidebarButton}" />

                <interface:SidebarButton DockPanel.Dock="Bottom"
                                         Command="{Binding OptionsCommand}"
                                         Icon="{StaticResource Options}"
                                         IsActive="False"
                                         Style="{StaticResource SidebarButton}" />

                <interface:SidebarButton DockPanel.Dock="Bottom"
                                         x:Name="UpdateButton"
                                         Visibility="Hidden"
                                         Command="{Binding UpdateCommand}">
                    <interface:SidebarButton.Style>
                        <Style TargetType="{x:Type interface:SidebarButton}"
                               BasedOn="{StaticResource SidebarButton}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type interface:SidebarButton}">
                                        <Border Background="{TemplateBinding Background}">
                                            <Image x:Name="UpdateImage"
                                                   Width="24" Height="24"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   gif:ImageBehavior.AnimatedSource="/Resources/update_available_sidebar.gif"
                                                   gif:ImageBehavior.AutoStart="False" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </interface:SidebarButton.Style>
                </interface:SidebarButton>
            </DockPanel>
        </Border>

        <!-- Container -->
        <StackPanel Grid.Column="1"
                    Margin="{StaticResource DefaultMarginTop}"
                    Orientation="Vertical">

            <views:ConnectionControl DataContext="{Binding Connection}"
                                     Visibility="{Binding DataContext.ConnectionContainerVisible,
                                                           RelativeSource={RelativeSource AncestorType=Window},
                                                           Converter={StaticResource FalseToCollapsedConverter}}" />

            <views:PresetsControl DataContext="{Binding Presets}"
                                  Visibility="{Binding DataContext.MemoryContainerVisible,
                                                       RelativeSource={RelativeSource AncestorType=Window},
                                                       Converter={StaticResource FalseToCollapsedConverter}}" />

            <views:MovementControl DataContext="{Binding Movement}"
                                   Visibility="{Binding DataContext.MoveContainerVisible,
                                                        RelativeSource={RelativeSource AncestorType=Window},
                                                        Converter={StaticResource FalseToCollapsedConverter}}" />

            <views:ZoomControl DataContext="{Binding Zoom}"
                               Visibility="{Binding DataContext.ZoomContainerVisible,
                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource FalseToCollapsedConverter}}" />
        </StackPanel>
    </Grid>
</Window>
