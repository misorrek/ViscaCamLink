<Window x:Class="ViscaCamLink.Views.OptionsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:resources="clr-namespace:ViscaCamLink.Resources"    
        xmlns:localization="clr-namespace:ViscaCamLink.Infrastructure.Localization"
        xmlns:viewmodels="clr-namespace:ViscaCamLink.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:OptionsViewModel}"
        Title="{Binding [Common_AppTitle], Source={x:Static localization:TranslationSource.Instance}}"
        Height="640"
        MinHeight="500"
        Width="550"
        MinWidth="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ViscaCamLink;component/Resources/CommonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Column="0"
                Grid.ColumnSpan="3"
                Grid.Row="0"
                Margin="{StaticResource DefaultMargin}"
                Style="{StaticResource BaseBorder}">
            <ScrollViewer Style="{StaticResource BaseScrollViewerStyle}">
                <Grid Margin="{StaticResource ExtendedMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Grid.Row="0"
                               Margin="0,0,0,8"
                               Text="{Binding [Options_General], Source={x:Static localization:TranslationSource.Instance}}"
                               Style="{StaticResource HeaderTextBlock}" />  

                    <TextBlock Grid.Column="0"
                               Grid.Row="1"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{Binding [Options_LanguageSelection], Source={x:Static localization:TranslationSource.Instance}}"
                               Style="{StaticResource BaseTextBlock}" />

                    <ComboBox Grid.Column="1"
                              Grid.Row="1"
                              Height="28"
                              ItemsSource="{Binding LanguageItems}"
                              SelectedValue="{Binding SelectedLanguage}"
                              SelectedValuePath="LanguageValue"
                              DisplayMemberPath="LanguageDisplay"
                              Style="{StaticResource BaseComboBox}"
                              ItemContainerStyle="{StaticResource BaseComboBoxItem}" />

                    <TextBlock Grid.Column="0"
                               Grid.Row="2"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{Binding [Options_ThemeSelection], Source={x:Static localization:TranslationSource.Instance}}"
                               Style="{StaticResource BaseTextBlock}" />

                    <ComboBox Grid.Column="1"
                              Grid.Row="2"
                              Height="28"
                              ItemsSource="{Binding ThemeItems}"
                              SelectedValue="{Binding SelectedTheme}"
                              SelectedValuePath="ThemeValue"
                              DisplayMemberPath="ThemeDisplay"
                              Style="{StaticResource BaseComboBox}"
                              ItemContainerStyle="{StaticResource BaseComboBoxItem}" />

                    <TextBlock Grid.Column="0"
                               Grid.Row="3"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{Binding [Options_MinimizeToCompactWindow], Source={x:Static localization:TranslationSource.Instance}}"
                               Style="{StaticResource BaseTextBlock}" />

                    <CheckBox Grid.Column="1"
                              Grid.Row="3"
                              Margin="0,8,0,0"
                              IsChecked="{Binding UseCompactView}"
                              Style="{StaticResource BaseCheckBox}" />

                    <TextBlock Grid.Column="0"
                               Grid.Row="4"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{Binding [Options_UsePresetGroups], Source={x:Static localization:TranslationSource.Instance}}"
                               Style="{StaticResource BaseTextBlock}" />

                    <CheckBox Grid.Column="1"
                              Grid.Row="4"
                              Margin="0,8,0,0"
                              IsChecked="{Binding UsePresetGroups}"
                              Style="{StaticResource BaseCheckBox}" />

                    <TextBlock Grid.Column="0"
                               Grid.Row="5"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{Binding [Options_NumpadLayout], Source={x:Static localization:TranslationSource.Instance}}"
                               Style="{StaticResource BaseTextBlock}" />

                    <CheckBox Grid.Column="1"
                              Grid.Row="5"
                              Margin="0,8,0,0"
                              IsChecked="{Binding UseNumpadLayout}"
                              Style="{StaticResource BaseCheckBox}" />

                    <TextBlock Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Grid.Row="11"
                               Margin="0,16,0,8"
                               Text="{Binding [Options_Support], Source={x:Static localization:TranslationSource.Instance}}"
                               Style="{StaticResource HeaderTextBlock}" />

                    <TextBlock Grid.Column="0"
                               Grid.Row="12"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{Binding [Options_LogLevel], Source={x:Static localization:TranslationSource.Instance}}"
                               Style="{StaticResource BaseTextBlock}" />

                    <ComboBox Grid.Column="1"
                              Grid.Row="12"
                              Height="28"
                              ItemsSource="{Binding LogLevels}"
                              SelectedItem="{Binding SelectedLogLevel}"
                              Style="{StaticResource BaseComboBox}"
                              ItemContainerStyle="{StaticResource BaseComboBoxItem}" />

                    <WrapPanel Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Grid.Row="13"
                               Margin="0,8,0,0"
                               Orientation="Horizontal">
                        <Button MinWidth="140"
                                Height="28"
                                Margin="0,0,8,0"
                                Padding="8,0"
                                Content="{Binding [Options_OpenLogsFolder], Source={x:Static localization:TranslationSource.Instance}}"
                                Command="{Binding OpenLogsFolderCommand}"
                                Style="{StaticResource DialogButton}" />

                        <Button MinWidth="140"
                                Height="28"
                                Margin="0,0,8,0"
                                Padding="8,0"
                                Content="{Binding [Options_ResetHints], Source={x:Static localization:TranslationSource.Instance}}"
                                Command="{Binding ResetHintsCommand}"
                                Style="{StaticResource DialogButton}" />

                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding [Options_HintsReset], Source={x:Static localization:TranslationSource.Instance}}"
                                   Visibility="{Binding AreHintsReset, Converter={StaticResource FalseToCollapsedConverter}}"
                                   Style="{StaticResource BaseTextBlock}" />
                    </WrapPanel>

                    <TextBlock Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Grid.Row="14"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Style="{StaticResource BaseTextBlock}">
                        <Run Text="{Binding [Options_Version], Source={x:Static localization:TranslationSource.Instance}, Mode=OneWay}" />
                        <Run Text="{Binding AppVersion, Mode=OneWay}" />
                    </TextBlock>

                    <!-- Hotkeys -->

                    <TextBlock Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Grid.Row="6"
                               Margin="0,16,0,8"
                               Text="{Binding [Options_Hotkeys], Source={x:Static localization:TranslationSource.Instance}}"
                               Style="{StaticResource HeaderTextBlock}" />

                    <TextBlock Grid.Column="0"
                               Grid.Row="7"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{Binding [Options_GlobalHotKeys], Source={x:Static localization:TranslationSource.Instance}}"
                               Style="{StaticResource BaseTextBlock}" />

                    <CheckBox Grid.Column="1"
                              Grid.Row="7"
                              IsChecked="{Binding UseGlobalHotKeys}"
                              Style="{StaticResource BaseCheckBox}" />

                    <TextBlock Grid.Column="0"
                               Grid.Row="8"
                                                              Margin="0,8,0,4"
                                                              Text="{Binding [Options_HotKeyAction], Source={x:Static localization:TranslationSource.Instance}}"
                               Style="{StaticResource BaseTextBlock}"
                               FontWeight="SemiBold" />

                    <TextBlock Grid.Column="1"
                               Grid.Row="8"
                                                              Margin="0,8,0,4"
                                                              HorizontalAlignment="Center"
                                                              Text="{Binding [Options_HotKeyBinding], Source={x:Static localization:TranslationSource.Instance}}"
                               Style="{StaticResource BaseTextBlock}"
                               FontWeight="SemiBold" />

                    <ItemsControl Grid.Column="0"
                                  Grid.ColumnSpan="2"
                                  Grid.Row="9"
                                  ItemsSource="{Binding HotKeyBindings}"
                                  IsTabStop="False">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewmodels:HotKeyBindingItemViewModel}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Text="{Binding ActionDisplayName}"
                                               Style="{StaticResource BaseTextBlock}" />

                                    <Button Grid.Column="1"
                                            Height="28"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding DataContext.HotKeyCaptureCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding ButtonText}">
                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}"
                                                   BasedOn="{StaticResource DialogButton}">
                                                <Setter Property="FontSize" Value="{StaticResource DefaultFontSize}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        
                                        <behaviors:Interaction.Triggers>
                                            <behaviors:EventTrigger EventName="PreviewKeyDown">
                                                <behaviors:InvokeCommandAction Command="{Binding DataContext.HotKeyPreviewKeyDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                               PassEventArgsToCommand="True" />
                                            </behaviors:EventTrigger>
                                        </behaviors:Interaction.Triggers>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Grid.Row="10"
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource StatusErrorBrush}"
                               Text="{Binding HotKeyValidationMessage}"
                               TextWrapping="Wrap"
                               Style="{StaticResource BaseTextBlock}" />
                </Grid>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Column="2"
                    Grid.Row="1"
                    Margin="0,0,4,4"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Height="32"
                    Width="120"
                    Content="{Binding [Common_OK], Source={x:Static localization:TranslationSource.Instance}}"
                    Command="{Binding OkCommand}"
                    Style="{StaticResource AccentButton}" />

            <Button Height="32"
                    Width="120"
                    Margin="4,0,0,0"
                    IsCancel="True"
                    Content="{Binding [Common_Cancel], Source={x:Static localization:TranslationSource.Instance}}" 
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource DialogButton}" />
        </StackPanel>    
    </Grid>
</Window>
