<UserControl x:Class="ViscaCamLink.Views.MovementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:util="clr-namespace:ViscaCamLink.Util"
             xmlns:types="clr-namespace:ViscaCamLink.Visca.Types"
             xmlns:viewmodels="clr-namespace:ViscaCamLink.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:MovementViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ViscaCamLink;component/Util/CommonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <util:Triggers x:Key="MoveTriggers" x:Shared="False">
                <behaviors:EventTrigger EventName="PreviewMouseLeftButtonDown">
                    <behaviors:InvokeCommandAction Command="{Binding MoveBeginCommand}" PassEventArgsToCommand="True" />
                </behaviors:EventTrigger>
                <behaviors:EventTrigger EventName="PreviewMouseLeftButtonUp">
                    <behaviors:InvokeCommandAction Command="{Binding MoveEndCommand}" PassEventArgsToCommand="True" />
                </behaviors:EventTrigger>
            </util:Triggers>

            <Style x:Key="MoveButton"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource LargeButton}">
                <Setter Property="Margin" Value="4,4,0,0" />
                <Setter Property="util:SupplementaryInteraction.Triggers"
                        Value="{StaticResource MoveTriggers}" />
                <Style.Triggers>
                    <Trigger Property="Grid.Column" Value="0">
                        <Setter Property="Margin" Value="0,4,0,0" />
                    </Trigger>
                    <DataTrigger Binding="{Binding DataContext.Connection.IsEditingConnection, 
                                                   RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DataContext.Presets.IsSettingMemory,
                                                   RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsMousePanning}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MousePadButton"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource LargeButton}">
                <Setter Property="Margin" Value="4,4,0,0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.Connection.IsEditingConnection, 
                                                   RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DataContext.Presets.IsSettingMemory,
                                                   RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsMousePanning}" Value="True">
                        <Setter Property="Background" Value="{StaticResource PrimaryHighlightBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryForegroundBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="HomeButton"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource BorderlessButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.Connection.IsEditingConnection, 
                                                   RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DataContext.Presets.IsSettingMemory,
                                                   RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsMousePanning}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MoveButtonPath"
                   TargetType="{x:Type Path}"
                   BasedOn="{StaticResource Icon16Path}">
                <Setter Property="Tag"
                        Value="{Binding (Button.Tag),
                                        RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Button}}}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource BaseBorder}">
        <Grid Margin="{StaticResource DefaultMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Column="0"
                       Grid.ColumnSpan="3"
                       Grid.Row="0"
                       Height="24"
                       LastChildFill="False">
                <TextBlock VerticalAlignment="Stretch"
                           Text="{Binding [Control_ContainerTitle], Source={x:Static util:TranslationSource.Instance}}"
                           Style="{StaticResource HeaderTextBlock}" />

                <Button DockPanel.Dock="Right"
                        Width="24"
                        VerticalAlignment="Stretch"
                        Command="{Binding HomeCommand}"
                        ToolTip="{Binding [Control_Home], Source={x:Static util:TranslationSource.Instance}}"
                        Style="{StaticResource HomeButton}">
                    <Path Data="{StaticResource Home}"
                          Style="{StaticResource Icon16Path}" />
                </Button>
            </DockPanel>

            <!-- Direction Control -->
            <Button Grid.Column="0" Grid.Row="1"
                    CommandParameter="{x:Static types:PanTiltDirection.PanLeftTiltUp}"
                    Style="{StaticResource MoveButton}">
                <Path Data="{StaticResource Angle}" Style="{StaticResource MoveButtonPath}">
                    <Path.LayoutTransform>
                        <RotateTransform Angle="45" />
                    </Path.LayoutTransform>
                </Path>
            </Button>

            <Button Grid.Column="1" Grid.Row="1"
                    CommandParameter="{x:Static types:PanTiltDirection.TiltUp}"
                    Style="{StaticResource MoveButton}">
                <Path Data="{StaticResource Angle}" Style="{StaticResource MoveButtonPath}">
                    <Path.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </Path.LayoutTransform>
                </Path>
            </Button>

            <Button Grid.Column="2" Grid.Row="1"
                    CommandParameter="{x:Static types:PanTiltDirection.PanRightTiltUp}"
                    Style="{StaticResource MoveButton}">
                <Path Data="{StaticResource Angle}" Style="{StaticResource MoveButtonPath}">
                    <Path.LayoutTransform>
                        <RotateTransform Angle="135" />
                    </Path.LayoutTransform>
                </Path>
            </Button>

            <Button Grid.Column="0" Grid.Row="2"
                    CommandParameter="{x:Static types:PanTiltDirection.PanLeft}"
                    Style="{StaticResource MoveButton}">
                <Path Data="{StaticResource Angle}" Style="{StaticResource MoveButtonPath}">
                    <Path.LayoutTransform>
                        <RotateTransform Angle="0" />
                    </Path.LayoutTransform>
                </Path>
            </Button>

            <Button Grid.Column="1" Grid.Row="2"
                    Cursor="SizeAll"
                    ToolTip="{Binding [Control_MousePan], Source={x:Static util:TranslationSource.Instance}}"
                    Style="{StaticResource MousePadButton}">
                <behaviors:Interaction.Triggers>
                    <behaviors:EventTrigger EventName="PreviewMouseLeftButtonDown">
                        <behaviors:InvokeCommandAction Command="{Binding MouseMovePanTiltCommand}" PassEventArgsToCommand="True" />
                    </behaviors:EventTrigger>
                    <behaviors:EventTrigger EventName="PreviewMouseMove">
                        <behaviors:InvokeCommandAction Command="{Binding MouseMovePanTiltCommand}" PassEventArgsToCommand="True" />
                    </behaviors:EventTrigger>
                    <behaviors:EventTrigger EventName="PreviewMouseLeftButtonUp">
                        <behaviors:InvokeCommandAction Command="{Binding MousePanEndCommand}" PassEventArgsToCommand="True" />
                    </behaviors:EventTrigger>
                </behaviors:Interaction.Triggers>

                <Path Data="{StaticResource MoveArrows}"
                      Style="{StaticResource Icon16Path}" />
            </Button>

            <Button Grid.Column="2" Grid.Row="2"
                    CommandParameter="{x:Static types:PanTiltDirection.PanRight}"
                    Style="{StaticResource MoveButton}">
                <Path Data="{StaticResource Angle}" Style="{StaticResource MoveButtonPath}">
                    <Path.LayoutTransform>
                        <RotateTransform Angle="180" />
                    </Path.LayoutTransform>
                </Path>
            </Button>

            <Button Grid.Column="0" Grid.Row="3"
                    CommandParameter="{x:Static types:PanTiltDirection.PanLeftTiltDown}"
                    Style="{StaticResource MoveButton}">
                <Path Data="{StaticResource Angle}" Style="{StaticResource MoveButtonPath}">
                    <Path.LayoutTransform>
                        <RotateTransform Angle="315" />
                    </Path.LayoutTransform>
                </Path>
            </Button>

            <Button Grid.Column="1" Grid.Row="3"
                    CommandParameter="{x:Static types:PanTiltDirection.TiltDown}"
                    Style="{StaticResource MoveButton}">
                <Path Data="{StaticResource Angle}" Style="{StaticResource MoveButtonPath}">
                    <Path.LayoutTransform>
                        <RotateTransform Angle="270" />
                    </Path.LayoutTransform>
                </Path>
            </Button>

            <Button Grid.Column="2" Grid.Row="3"
                    CommandParameter="{x:Static types:PanTiltDirection.PanRightTiltDown}"
                    Style="{StaticResource MoveButton}">
                <Path Data="{StaticResource Angle}" Style="{StaticResource MoveButtonPath}">
                    <Path.LayoutTransform>
                        <RotateTransform Angle="225" />
                    </Path.LayoutTransform>
                </Path>
            </Button>

            <!-- Speed Control -->
            <Grid Grid.Column="0"
                  Grid.ColumnSpan="3"
                  Grid.Row="4"
                  Height="24"
                  Margin="0,12,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Margin="0,0,8,0"
                        Width="24"
                        Command="{Binding MoveSpeedDecreaseCommand}"
                        Style="{StaticResource BorderlessButton}">
                    <Path Data="{StaticResource TachometerSlow}"
                          Style="{StaticResource Icon16Path}" />
                </Button>

                <Slider Grid.Column="1"
                        Minimum="1"
                        Maximum="{Binding MaximalPanTiltSpeed}"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Value="{Binding PanTiltSpeed}"
                        Style="{StaticResource HorizontalSlider}" />

                <Button Grid.Column="2"
                        Margin="8,0,0,0"
                        Width="24"
                        Command="{Binding MoveSpeedIncreaseCommand}"
                        Style="{StaticResource BorderlessButton}">
                    <Path Data="{StaticResource TachometerFast}"
                          Style="{StaticResource Icon16Path}" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
