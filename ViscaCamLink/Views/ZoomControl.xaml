<UserControl x:Class="ViscaCamLink.Views.ZoomControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:interface="clr-namespace:ViscaCamLink.Infrastructure.Interface"   
             xmlns:localization="clr-namespace:ViscaCamLink.Infrastructure.Localization"
             xmlns:types="clr-namespace:ViscaCamLink.Visca.Types"
             xmlns:viewmodels="clr-namespace:ViscaCamLink.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:ZoomViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ViscaCamLink;component/Resources/CommonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <interface:Triggers x:Key="ZoomTriggers" x:Shared="False">
                <behaviors:EventTrigger EventName="PreviewMouseLeftButtonDown">
                    <behaviors:InvokeCommandAction Command="{Binding ZoomCommand}" PassEventArgsToCommand="True" />
                </behaviors:EventTrigger>
                <behaviors:EventTrigger EventName="PreviewMouseLeftButtonUp">
                    <behaviors:InvokeCommandAction Command="{Binding ZoomCommand}" PassEventArgsToCommand="True" />
                </behaviors:EventTrigger>
            </interface:Triggers>

            <Style x:Key="ZoomButton"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource LargeButton}">
                <Setter Property="Margin" Value="4,4,0,0" />
                <Setter Property="interface:SupplementaryInteraction.Triggers"
                        Value="{StaticResource ZoomTriggers}" />
                <Style.Triggers>
                    <Trigger Property="Grid.Column" Value="0">
                        <Setter Property="Margin" Value="0,4,0,0" />
                    </Trigger>
                    <DataTrigger Binding="{Binding DataContext.Connection.IsEditingConnection, 
                                                   RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DataContext.Presets.IsSettingMemory,
                                                   RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SpeedButton"
                   TargetType="{x:Type Button}"
                   BasedOn="{StaticResource BorderlessButton}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.Connection.IsEditingConnection,
                                                   RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DataContext.Presets.IsSettingMemory,
                                                   RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SpeedSlider"
                   TargetType="{x:Type Slider}"
                   BasedOn="{StaticResource HorizontalSlider}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.Connection.IsEditingConnection,
                                                   RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DataContext.Presets.IsSettingMemory,
                                                   RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource BaseBorder}">
        <Grid Margin="{StaticResource DefaultMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Column="0"
                       Grid.ColumnSpan="2"
                       Grid.Row="0"
                       Text="{Binding [Zoom_ContainerTitle], Source={x:Static localization:TranslationSource.Instance}}"
                       Style="{StaticResource HeaderTextBlock}" />

            <!-- Zoom Control -->
            <Button Grid.Column="0" Grid.Row="1"
                    CommandParameter="{x:Static types:ZoomDirection.Out}"
                    Style="{StaticResource ZoomButton}">
                <Path Data="{StaticResource ZoomOut}"
                      Style="{StaticResource Icon16Path}" />
            </Button>

            <Button Grid.Column="1" Grid.Row="1"
                    CommandParameter="{x:Static types:ZoomDirection.In}"
                    Style="{StaticResource ZoomButton}">
                <Path Data="{StaticResource ZoomIn}"
                      Style="{StaticResource Icon16Path}" />
            </Button>

            <!-- Speed Control -->
            <Grid Grid.Column="0"
                  Grid.ColumnSpan="2"
                  Grid.Row="2"
                  Height="24"
                  Margin="0,12,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Margin="0,0,8,0"
                        Width="24"
                        Command="{Binding ZoomSpeedDecreaseCommand}"
                        ToolTip="{Binding [Zoom_DecreaseSpeed], Source={x:Static localization:TranslationSource.Instance}}"
                        Style="{StaticResource SpeedButton}">
                    <Path Data="{StaticResource TachometerSlow}"
                          Style="{StaticResource Icon16Path}" />
                </Button>

                <Slider Grid.Column="1"
                        Minimum="1"
                        Maximum="{Binding MaximalZoomSpeed}"
                        IsSnapToTickEnabled="True"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Value="{Binding ZoomSpeed}"
                        Style="{StaticResource SpeedSlider}" />

                <Button Grid.Column="2"
                        Margin="8,0,0,0"
                        Width="24"
                        Command="{Binding ZoomSpeedIncreaseCommand}"
                        ToolTip="{Binding [Zoom_IncreaseSpeed], Source={x:Static localization:TranslationSource.Instance}}"
                        Style="{StaticResource SpeedButton}">
                    <Path Data="{StaticResource TachometerFast}"
                          Style="{StaticResource Icon16Path}" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
