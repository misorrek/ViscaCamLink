<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette and contrast ratios: Docs/THEMING.md. Keys must match the other theme file. -->

    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#F7F6FC" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#33214E" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#51367B" />
    <SolidColorBrush x:Key="SidebarContentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarInactiveIconBrush" Color="#B8B4C4" />
    <SolidColorBrush x:Key="TextBrush" Color="#000000" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5F5B6B" />
    <SolidColorBrush x:Key="AccentBrush" Color="#51367B" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#654499" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3F2A61" />
    <SolidColorBrush x:Key="AccentContentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#D3CCF9" />
    <SolidColorBrush x:Key="PressedBackgroundBrush" Color="#BAADF4" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#BAADF4" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D3D3D3" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#8A8497" />
    <SolidColorBrush x:Key="HoverBorderBrush" Color="#BAADF4" />
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#7A5CC8" />
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#F2F0FD" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#9A96A6" />
    <SolidColorBrush x:Key="StatusOkBrush" Color="#1E8E3E" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#B26A00" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#C62828" />
    <SolidColorBrush x:Key="StatusUnknownBrush" Color="#8A8497" />

</ResourceDictionary>
