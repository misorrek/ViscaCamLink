<Window x:Class="ViscaCamLink.Common.MessageView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ViscaCamLink.Common.Messaging"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:MessageViewModel}"
        Title="{Binding Title}"        
        Width="480"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ViscaCamLink.Common;component/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Orientation="Vertical">

        <Border Margin="{StaticResource DefaultMargin}"
                Style="{StaticResource BaseBorder}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Ellipse Grid.Column="0"
                         Grid.Row="0"
                         Margin="8"
                         Height="40"
                         Width="40">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0.25,0"
                                             EndPoint="0.75,1">
                            <GradientStop Color="White"
                                          Offset="-0.75" />
                            <GradientStop Color="{Binding IconBackgroundColor}"
                                          Offset="1" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Path Grid.Column="0"
                      Grid.Row="0"
                      Height="20"
                      Width="20"
                      Fill="White"
                      Stretch="Uniform"
                      Data="{Binding Icon}" />

                <TextBlock Grid.Column="1"
                           Grid.Row="0"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding Title}"
                           Style="{StaticResource HeaderTextBlock}" />

                <TextBlock Grid.Column="1"
                           Grid.Row="1"
                           Margin="4,0,0,8"
                           Text="{Binding Text}"
                           TextWrapping="Wrap"
                           Style="{StaticResource BaseTextBlock}" />
            </Grid>
        </Border>

        <StackPanel Height="28"
                    Margin="{StaticResource DefaultMarginTopless}"
                    Orientation="Horizontal"
                    FlowDirection="RightToLeft">

            <Button Width="120"
                    TabIndex="2"
                    Content="{Binding CancelButtonText}"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource DialogButton}" />

            <Button Width="120"
                    Margin="4,0,0,0"
                    TabIndex="1"
                    Content="{Binding OkButtonText}"
                    Command="{Binding OkCommand}"
                    Style="{StaticResource DialogButton}" />
        </StackPanel>
    </StackPanel>
</Window>
